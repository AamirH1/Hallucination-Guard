# ---- LLM provider (generation) ----
# One of: mock, openai, anthropic, gemini, openrouter, kimi, qwen
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
KIMI_API_KEY=
QWEN_API_KEY=

# Override base_url for any OpenAI-compatible provider (openrouter/kimi/qwen/custom)
LLM_BASE_URL=

# ---- Embeddings ----
# One of: local, openai
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- Vector store ----
# One of: chroma, weaviate, elasticsearch, azure
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./data/chroma
WEAVIATE_URL=
ELASTICSEARCH_URL=
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=

RERANKER_ENABLED=false

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Observability ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
TRACE_LOCAL_DIR=./data/traces

# ---- Governance thresholds ----
GROUNDING_THRESHOLD=0.85
RETRIEVAL_THRESHOLD=0.70
MAX_REGENERATION_ATTEMPTS=2

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
